					'''
					Fires a short-range kunai
					Stealth strikes home and explode.
					'''
			}

			BucketofCoal: {
				DisplayName: Bucket of Coal
				Tooltip:
					'''
					Throws a bucket of coal that flings out smaller bits of coal as it travels
					Stealth strikes cause the bits to grow in size and damage over time
					'''
			}

			FracturingFist: {
				DisplayName: Fracturing Fist
				Tooltip:
					'''
					Fires a fist that splits into two more fists upon collision
					Stealth strikes make the fist ricochet between enemies up to 4 times while spawning crystal shards
					'''
			}

			ContaminatedDish: {
				DisplayName: Contaminated Dish
				Tooltip:
					'''
					Tosses out a really old Petri dish that explodes upon hitting enemies or tiles, releasing plague nanobots in the process
					Stealth strike causes them to be thrown harder, sticking glass shards into them in the process
					'This thing's really old by now, best not breathe it in too much...'
					'''
			}

			MoltenPiercer: {
				DisplayName: Molten Piercer
				Tooltip: Throws flaming knives that break into obsidian shards on hit
			}

			CreatureCapsule: {
				DisplayName: Creature Capsule
				Tooltip:
					'''
					Throws a capsule that explodes, releasing a ghost that shoots projectiles
					Stealth strikes cause multiple ghosts to exit the capsule, and increases crit chance by 25%. Critical hits will instantly capture any non boss enemy.
					'''
			}

			Pastranion: {
				DisplayName: Pastranion
				Tooltip:
					'''
					Throws out bowls with strands which lash out at nearby enemies
					Stealth strikes have much longer, aggressive strands
					'''
			}

			VermillionAngel: {
				DisplayName: Vermillion Angel
				Tooltip:
					'''
					Throws an ultra high velocity spear, which creates more projectiles that home in
					The spear creates a Vermillion Blast upon hitting an enemy
					Stealth strikes grant summon a star of projectiles upon hitting an enemy
					"It all comes tumbling down tumbling down tumbling down."
					'''
			}

			StellarKunai: {
				DisplayName: Stellar Kunai
				Tooltip:
					'''
					Throws out a set of three kunai that ignore gravity and slightly home in on enemies
					After traveling enough distance, the kunai supercharge with Stellar energy, homing in far more aggressively and exploding on impact
					Stealth Strikes instantly throw eight supercharged Kunai
					'''
			}

			ExifFist: {
				DisplayName: Exif Fist
				Tooltip:
					'''
					Fires a fist that explodes into stars
					Stealth strikes make the fist ricochet between enemies up to 5 times while raining stars
					'''
			}

			HandofGod: {
				DisplayName: Hand of God
				Tooltip:
					'''
					Fires a fist that explodes into planets
					Stealth strikes make the fist ricochet between enemies up to 7 times before unleashing a colossal explosion
					'''
			}

			WulfrumShockCutter: {
				DisplayName: Wulfrum Shock Cutter
				Tooltip:
					'''
					Fires wulfrum shock cutters in bursts of 3
					Stealth strikes make the cutters fly further and hit several times at once
					Hold right click to magnetize all nearby cutters back to you
					'''
			}

			Crustalline: {
				DisplayName: Crustalline
				Tooltip:
					'''
					Throws daggers that orbit you and stick to tiles
					Stealth strikes cause the blade to shatter into harmfull pieces
					'''
			}

			SeaStoneShuriken: {
				DisplayName: Sea Stone Shuriken
				Tooltip: ""
			}

			DirtClump: {
				DisplayName: Dirt Clump
				Tooltip:
					'''
					Throws a ball of dirt
					Stealth strikes break into smaller dirt clumps that hit nearby enemies
					'''
			}

			AcidicRainBarrel: {
				DisplayName: Acidic Rain Barrel
				Tooltip:
					'''
					Throws a rolling barrel that explodes on wall collision
					Stealth strikes make it rain on collision
					'''
			}

			Nychthemeron: {
				DisplayName: Nychthemeron
				Tooltip:
					'''
					Throws a spiky ball that ignores gravity and summons a pair of light and dark orbs that orbit the player
					Once the spiky ball disappears the orbs will home in on the nearest target
					Stacks up to 10
					Stealth strikes cause all spiky balls and orbs to be thrown at once
					Right click to recall all existing spiky balls
					'''
			}

			HellsSun: {
				DisplayName: Hell's Sun
				Tooltip:
					'''
					The Subterranean Sun in the palm of your hand.
					Shoots a gravity-defying spiky ball. Stacks up to 10.
					Once stationary, periodically emits small suns that explode on hit
					Stealth strikes emit suns at a faster rate and last for a longer amount of time
					Right click to delete all existing spiky balls
					'''
			}

			PoisonPack: {
				DisplayName: Poison Pack
				Tooltip:
					'''
					Throws a poisonous spiky ball. Stacks up to 3.
					Stealth strikes cause the balls to release spore clouds
					Right click to delete all existing spiky balls
					'''
			}

			MonkeyDarts: {
				DisplayName: Monkey Darts
				Tooltip:
					'''
					Stealth strikes throw 3 bouncing darts at high speed
					'Perfect for popping'
					'''
			}

			SkyStabber: {
				DisplayName: Sky Stabber
				Tooltip:
					'''
					Shoots a gravity-defying spiky ball. Stacks up to 4.
					Stealth strikes make the balls rain feathers onto enemies when they hit
					Right click to delete all existing spiky balls
					'''
			}

			StickySpikyBall: {
				DisplayName: Sticky Spiky Ball
				Tooltip:
					'''
					Throws a spiky ball that sticks to everything
					Stealth strikes throw seven at once and last a lot longer
					'''
			}

			BouncySpikyBall: {
				DisplayName: Bouncy Spiky Ball
				Tooltip:
					'''
					Throws a very bouncy ball that richochets off walls and enemies
					Receives a small boost in damage and velocity after bouncing off an enemy
					Stealth strikes provide a bigger boost after richocheting
					'''
			}

			PhantomLance: {
				DisplayName: Phantom Lance
				Tooltip:
					'''
					Fires a spectral javelin that rapidly releases lost souls
					Fades away and slows down over time
					Lost souls released later deal less damage
					Stealth strikes don't slow down and souls always deal full damage
					'''
			}

			Sandslasher: {
				DisplayName: Sandslasher
				Tooltip:
					'''
					Throws a huge shuriken made out of fused sand unaffected by gravity which slowly accelerates horizontally
					It does more damage depending on how fast it goes horizontally and how long it has been flying for
					Stealth strikes periodically release sand clouds
					'''
			}

			Phlegm: {
				DisplayName: Phlegm
				Tooltip: ""
			}

			PoisonIBee: {
				DisplayName: Poison I-Bee
				Tooltip:
					'''
					Throws out disks which release thorns upon hitting enemies
					Stealth strikes cause the disk to fling out seeds in random directions
					'''
			}

			ShockGrenade: {
				DisplayName: Shock Grenade
				Tooltip:
					'''
					Throws a grenade that explodes into a burst of lightning
					Stealth strikes cause the grenade to leave an electrifying aura when it explodes
					'''
			}

			NightsGaze: {
				DisplayName: Night's Gaze
				Tooltip:
					'''
					Strike your foes with this spear of the night
					Throws a spear that shatters when it hits an enemy
					Stealth strikes cause the spear to summon homing stars as it flies
					'''
			}

			CatastropheClaycore: {
				DisplayName: Catastrophe Claycore
				Tooltip:
					'''
					Tosses claycore-type bombs that explode into energy bolts on impact
					Stealth strikes cause bombs to explode into more bolts
					'''
			}

			Warglaive: {
				DisplayName: Warglaive
				Tooltip: Stealth strikes stick to tiles
			}

			AlphaVirus: {
				DisplayName: Alpha Virus
				Tooltip:
					'''
					Throws a giant plague cell with a lethal aura that splits into 6 plague seekers on death
					Stealth strikes cause the plague cell to move slower, accumulating an aura of swirling plague seekers as it flies
					'''
			}
		}
	}

	GuardiansWrath: {
		DisplayName: Guardians Wrath
		Tooltip: Right click to throw your trident. Right click again to strike it with lightning.
	}

	Hailberd: {
		DisplayName: Hailberd
		Tooltip: Summons a group of halberds near your cursor.
	}

	PizzaWheel: {
		DisplayName: Pizza Wheel
		Tooltip: Summons pizzas that roll across the screen
	}

	SignoftheOperator: {
		DisplayName: Sign of the Operator
		Tooltip: Summon forth tendrils from the abyss to attack your foes.
	}

	ElderBerry: {
		DisplayName: Elder Berry
		Tooltip:
			'''
			Permanently gives the player a dash
			Press the Elder Berry Dash key to dash
			'''
	}

	MetamorphicStone: {
		DisplayName: Metamorphic Stone
		Tooltip: Summons an earth elemental to fight for you
	}
	Axisdriver: {
		DisplayName: Axisdriver
		Tooltip:
			'''
			Shoots a burst of 3 exo bullets that tear through enemies
			Critical hits rain elemental bolts from above
			Right click to fire an explosive homing exo bullet
			50% chance to not consume bullets
			'''
	}

	Obsidigun: {
		DisplayName: Obsidigun
		Tooltip: Converts musket balls into fast-moving obsidian bullets that break into shards on hit
	}

	OnyxMinigun: {
		DisplayName: Onyx Minigun
		Tooltip:
			'''
			70% chance to not consume ammo
			Fires a storm of bullets and onyx shards
			'''
	}

	SDOMG: {
		DisplayName: SDOMG
		Tooltip:
			'''
			75% chance to not consume ammo
			Rapidly fires a spread of bullets that close in over time
			Right clicking while standing still consumes a Plasma Grenade to fire a large deathray
			While the deathray is active, you are afflicted with slow, on fire, and oiled
			'''
	}

	TheGenerator: {
		DisplayName: The Generator
		Tooltip:
			'''
			Ugh! I hate having to rely on you, and your vacant stare when I revealed my grand plan was truly insulting. Well, let's see if you can break this thing on my head. If you can, then someday... hee hee hee...I may get to toy with you again!
			Launches a master crown sigil that draws in nearby enemies
			'''
	}

	WorstPrism: {
		DisplayName: Worst Prism
		Tooltip: Will probably give enemies epilepsy
	}

	UnendingVoid: {
		DisplayName: Unending Void
		Tooltip:
			'''
			[c/2d0f33:Its eerie persistence gnawed at my mind. It did not just threaten me. It threatened everyone. Everything.]
			Fires a ring of dark energy orbs to home in on nearby enemies
			Orbs tear the fabrics of spacetime on enemy hits
			'''
	}

	Garth: {
		DisplayName: Garth
		Tooltip:
			'''
			Lowers enemy defense by 1 with every strike
			Your attacks will heal you a lot
			Rains RGB meteors that explode into more meteors after a short time on enemy hits
			Ice meteors freeze enemies
			Flame meteors explode
			Green meteors spawn healing orbs
			'''
	}

	LargeFather: {
		DisplayName: Large Father
		Tooltip: Right click to swing the drill, mining a large area ahead
	}

	PrehistoricTablet: {
		DisplayName: Prehistoric Tablet
		Tooltip:
			'''
			One of the ancient relics
			Summons a sulphur elemental to fight for you
			'''
	}
	ElementalSawLauncher: {
		DisplayName: Elemental Saw Launcher
		Tooltip:
			'''
			Does not consume ammo
			Hold left click to charge a saw
			Letting go of left click releases the saw
			Pressing right click while the saw is out will call it back to you faster, causing an explosion
			'''
	}
	SoulofPyrogen: {
		DisplayName: Soul of Pyrogen
		Tooltip:
			'''
			20% increased Melee damage
			True Melee strikes create spears from the ground
			'''
	}

	SearedShredder: {
		DisplayName: Seared Shredder
		Tooltip: Shoots a flame scythe
	}

	HellsBells: {
		DisplayName: Hell's Bells
		Tooltip: Summons an obsidian bell that follows the cursor
	}
	FlamingIceBow: {
		DisplayName: Flaming Ice Bow
		Tooltip:
			'''
			Causes all arrows to inflict frostburn
			Damages the user while held
			'''
		Death: "{0} burned their hands on the Flaming Ice Bow."
	}

	Baow: {
		DisplayName: Baow
		Tooltip: Fires a second arrow mirroring the first
	}

	TwentyTwoHornetRound: {
		DisplayName: 22 Hornet Round
		Tooltip:
			'''
			Pierces the hearts of gods...
			Ricochets up to 21 times off of hit enemies
			'''
	}
	AquaticHypercomputer: {
		DisplayName: Aquatic Hypercomputer
		Tooltip: A hypercomputer capable of reconstructing reality.
	}

	StaticHypermodule: {
		DisplayName: Static Hypermodule
		Tooltip: Can be placed on the hypercomputer to increase its reconstructing power
	}

	CapsuleVaultModule: {
		DisplayName: Capsule Vault Module
		Tooltip: Can be placed on the hypercomputer if it has a Static Hypermodule.
	}

	ElementalCapsuleBox: {
		DisplayName: Elemental Capsule Box
		Tooltip: Contains capsules that can be placed in the Capsule vault to increase Hypercomputer's powers
	}

	EnchantedReconstructionModule: {
		DisplayName: Enchanted Reconstruction Module
		Tooltip: Can be placed on the Hypercomputer after The capsule vault was filled.
	}

	AbyssblastLaserModule: {
		DisplayName: Abyssblast Laser Module
		Tooltip: Can be placed on the Hypercomputer after the Enchanted Reconstruction Module to increase its power. Creates an aura that Evercolds your enemies
	}
	WulfrumLenses: {
		DisplayName: Wulfrum Lenses
		Tooltip: Highlights nearby treasure.
	}

	WulfrumFusionArray: {
		DisplayName: Wulfrum Fusion Array
		Tooltip:
			'''
			4 summon tag damage
			Fires quick bursts of medium-range pellets
			[c/83B87E:Who needs whips when you can simply use a fusion cannon?]
			'''
	}
	AcidBow: {
		DisplayName: Acid Bow
		Tooltip:
			'''
			Fires two arrows
			Converts wooden arrows into arrows that inflict irradiated
			'''
	}

	Butcher: {
		DisplayName: Butcher
		Tooltip: Fires faster and more accurately the longer you hold the trigger
	}

	TalonBurst: {
		DisplayName: Talon Burst
		Tooltip:
			'''
			Turns wooden arrows into Storm Bolts, which can hit the same target twice
			'''
	}

	Titanslayer: {
		DisplayName: Titanslayer
		Tooltip:
			'''
			Fires a stream of 8 homing spectral bolts
			Every 3 uses supercharges the bolts, causing them to explode into souls and grants them additional critical strike chance
			'''
	}

	AspidBlaster: {
		DisplayName: Aspid Blaster
		Tooltip: Fires an irritating spread of infected orbs
	}

	CausticClaw: {
		DisplayName: Caustic Claw
		Tooltip: Casts caustic tendrils that inflict irradiated
	}

	SteelBlade: {
		DisplayName: Steel Blade
		Tooltip:
			'''
			The amount of contact damage an enemy does is added to this weapons' damage
			You must hit an enemy with the blade to trigger this effect
			'''
	}

	SwiftSword: {
		DisplayName: Swift Sword
		Tooltip:
			'''
			Deals more damage the faster you are moving
			Increases your movement speed on kill
			Some demented esoteric enjoyers pretend that pocket dimensions exist. They never explain what it means, though.
			'''
	}

	CalamitySword: {
		DisplayName: Calamity Sword
		Tooltip:
			'''
			Shoots a sword beam when swung, If it hits an enemy, it explodes into Sword Fragments that home in after a few seconds that deal 25% of the weapons current damage.
			'''
	}
	PoisonedSclera: {
		DisplayName: Poisoned Sclera
		Tooltip:
			'''
			Summons the Acidsighter when used in the sulphurous sea at night
			Not consumable
			'''
	}

	AcidsighterBag: {
		DisplayName: Treasure Bag (Acidsighter)
		Tooltip:
			'''
			{$CommonItemTooltip.RightClickToOpen}
			'''
	}

	PungentBomber: {
		DisplayName: Pungent Bomber
		Tooltip: Leaves acid bombs when striking enemies
	}

	CorrosiveEyeStaff: {
		DisplayName: Corrosive Eye Staff
		Tooltip: Summons corroded eyes that orbit you and shoot acid shots
	}
	Arngren: {
		DisplayName: Arngren
		Tooltip: 80% chance to not consume ammo
	}

	FlounderMortar: {
		DisplayName: Flounder Mortar
		Tooltip: Converts musket balls into streams of acid
	}

	Megaskeet: {
		DisplayName: Megaskeet
		Tooltip:
			'''
			50% chance to not consume ammo
			Fires streams of hard sunlight every other shot
			Fires a homing sunskater every 17 shots, which explodes into cinder shards on death
			'''
	}

	Confection: {
		DisplayName: Confection
		Tooltip:
			'''
			'Memories of the deep sea'
			Fires out strong cake arrows that explode into puddles of damaging frosting
			'''
	}

	DualCane: {
		DisplayName: Dual Cane
		Tooltip: Fires black and white orbs that travel in a helix pattern
	}

	HeavenPiercer: {
		DisplayName: Heaven Piercer
		Tooltip:
			'''
			Collapses almost any blocks it touches
			Right click to fire a helix laser that instantly breaks tiles it touches
			'''
	}
	OnyxGunblade: {
		DisplayName: Onyx Gunblade
		Tooltip:
			'''
			Sword of the clan
			Uses bullets to fires onyx blasts
			'''
	}

	OnyxStaff: {
		DisplayName: Onyx Staff
		Tooltip: Shoots three black bolts
	}

	ThunderBolt: {
		DisplayName: Thunder Bolt
		Tooltip: Casts a slow-moving ball of lightning
	}

	AeroBolt: {
		DisplayName: Aero Bolt
		Tooltip: Casts a slow-moving mini hurricanes
	}

	PlasmaflashBolt: {
		DisplayName: Plasmaflash Bolt
		Tooltip: Casts a quick-moving ball of plasma
	}

	RoseBow: {
		DisplayName: Rose Bow
		Tooltip:
			'''
			'Even if you can't see me, even if you can't hear me, I'll be by your side'
			Fires a fast stream of arrows
			Wooden arrows are converted into energy arrows that slash hit enemies
			'''
	}

	Pumplerfaust: {
		DisplayName: Pumplerfaust
		Tooltip:
			'''
			Hold left click to inflate a white pumpkin at the tip of the weapon's barrel
			Release to shoot the pumpkin, which will explode on impact
			If the pumpkin is fully charged, it will create a massive explosion with lingering mist
			'''
	}

	Gourdler: {
		DisplayName: Gourdler
		Tooltip:
			'''
			Hold left click to load up to eight gourd grenades into the gun
			Gourd grenades explode into a burst of spikes
			'''
	}
	DarkEnergyStaff: {
		DisplayName: Dark Energy Staff
		Tooltip:
			'''
			Summons a dark energy turret to fight for you
			Two can exist at once
			'''
	}

	JetEngine: {
		DisplayName: Jet Engine
		Tooltip: Summons an onyx fist to punch enemies for you
	}

	TwistedNetheriteScythe: {
		DisplayName: Twisted Netherite Scythe
		Tooltip: Provides 10 frames of immunity on enemy hits.
	}

	WrathoftheEldritch: {
		DisplayName: Wrath of the Eldritch
		Tooltip: Summons an eldritch pulse at the cursor that periodically summon two rings of homing spirits and occasionally a deathray
	}

	WrathoftheCosmos: {
		DisplayName: Wrath of the Cosmos
		Tooltip: Summons a galactic pulse at the cursor that periodically summon two rings of homing god slayer fireballs and occasionally two cosmic guardians
	}
}

