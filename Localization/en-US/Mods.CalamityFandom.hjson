		DisplayName: Tomatus
		Tooltip:
			'''
			Enemies explode on hit
			Shortflurry attacks inflict Hellfire
			'''
	}

	NightsStabber: {
		DisplayName: Night's Stabber
		Tooltip:
			'''
			Don't underestimate the power of stabby knives
			Enemies release homing dark energy on hit
			Shortflurry attacks heal the player, spawn night vines,
			Inflict Cursed Inferno, and increase melee speed
			'''
	}

	LeechingDagger: {
		DisplayName: Leeching Dagger
		Tooltip:
			'''
			Enemies release homing leech orbs on hit
			Shortflurry strikes heal the player for 5 health per hit
			'''
	}

	BloodyRupture: {
		DisplayName: Bloody Rupture
		Tooltip:
			'''
			Enemies release homing blood orbs on death
			Shortflurry attacks create bloodsplosions on enemy hits
			'''
	}

	AncientShiv: {
		DisplayName: Ancient Shiv
		Tooltip:
			'''
			Enemies release a blue aura cloud on death
			Shortflurry attacks increase melee speed by 5%
			'''
	}

	EutrophicShank: {
		DisplayName: Eutrophic Shank
		Tooltip:
			'''
			Shoots electric sparks
			Shortflurry attacks inflict Eutrophication
			'''
	}

	AquaticDischarge: {
		DisplayName: Aquatic Discharge
		Tooltip:
			'''
			Enemies release electric sparks on death
			Shortflurry attacks paralyze enemies
			'''
	}

	Weapons: {
		Rogue: {
			PhantomLance: {
				DisplayName: Phantom Lance
				Tooltip:
					'''
					Fires a spectral javelin that rapidly releases lost souls
					Fades away and slows down over time
					Lost souls released later deal less damage
					Stealth strikes don't slow down and souls always deal full damage
					'''
			}

			Sandslasher: {
				DisplayName: Sandslasher
				Tooltip:
					'''
					Throws a huge shuriken made out of fused sand unaffected by gravity which slowly accelerates horizontally
					It does more damage depending on how fast it goes horizontally and how long it has been flying for
					Stealth strikes periodically release sand clouds
					'''
			}

			Phlegm: {
				DisplayName: Phlegm
				Tooltip: ""
			}

			PoisonIBee: {
				DisplayName: Poison I-Bee
				Tooltip:
