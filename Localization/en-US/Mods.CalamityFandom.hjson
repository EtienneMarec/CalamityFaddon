Items: {
	Zweihandromeda: {
		DisplayName: Zweihandromeda
		Tooltip: ""
	}

	FandomTestVial: {
		DisplayName: Fandom Test Vial
		Tooltip:
			'''
			[c/FF8040:Debug item]
			Left click: inflicts the selected debuff on you and on the nearest enemy (10 seconds)
			Right click: selects the next debuff
			'''
		Selected: Selected debuff: {0}
		Applied: "{0} applied to you and to: {1}"
	}

	TestSword: {
		DisplayName: Test Sword: {0}
		Tooltip:
			'''
			[c/FF8040:Debug item]
			Inflicts {0} on hit, following the rules of the current accuracy mode
			'''
	}

	FandomDummySpawner: {
		DisplayName: Fandom Dummy Spawner
		Tooltip:
			'''
			[c/FF8040:Debug item]
			Left click: places a Fandom Test Dummy at the cursor (1 000 000 life, never dies, neutral to every element)
			Right click: removes every Fandom Test Dummy
			'''
	}

	BleachedAnglingKit: {
		DisplayName: Bleached Angling Kit
		Tooltip:
			'''
			Has a chance to contain various fishing gear
			{$CommonItemTooltip.RightClickToOpen}
			'''
	}

	SandyAnglingKit: {
		DisplayName: Sandy Angling Kit
		Tooltip:
			'''
			Has a chance to contain various fishing gear
			{$CommonItemTooltip.RightClickToOpen}
			'''
	}

	SeaboundStaff: {
		DisplayName: Seabound Staff
		Tooltip: Summons a brittle star to fight for you
	}

	EffluviumBow: {
		DisplayName: Effluvium Bow
		Tooltip:
			'''
			Fires two arrows at once
			Converts wooden arrows into mist arrows
			'''
	}

	Regenator: {
		DisplayName: Regenator
		Tooltip: Reduces max HP by 50% but greatly improves life regeneration
	}

	StormSpray: {
		DisplayName: Storm Spray
		Tooltip: Fires a spray of water that drips extra trails of water
	}

	SolarFlare: {
		DisplayName: Solar Flare
		Tooltip:
			'''
			Emits large holy explosions on hit
			A very agile yoyo
			'''
	}

	DiseasedPike: {
		DisplayName: Diseased Pike
		Tooltip: Fires plague seekers on hit
	}

	Disseminator: {
		DisplayName: Disseminator
		Tooltip:
			'''
			50% chance to not consume ammo
			Fires a spread of bullets from the gun, above, and below
			'''
	}

	WrathoftheAncients: {
		DisplayName: Wrath of the Ancients
		Tooltip: Summons an energy pulse at the cursor to periodically summon homing spirits
	}

	AstralRepeater: {
		DisplayName: Astral Bow
		Tooltip: Fires a burst of three arrows
	}

	Lazhar: {
		DisplayName: Lazhar
		Tooltip: Fires a bouncing laser that explodes on enemy hits
	}

	CarnageRay: {
		DisplayName: Carnage Ray
		Tooltip:
			'''
			Fires a blood ray
			The farther along the ray hit enemies are, the more damage they take
			'''
	}

	EutrophicScimitar: {
		DisplayName: Eutrophic Scimitar
		Tooltip: Fires a beam upon swing that stuns enemies
	}

	Aftershock: {
		DisplayName: Aftershock
		Tooltip: Summons boulders from the sky on enemy hits
	}

	AsteroidStaff: {
		DisplayName: Asteroid Staff
		Tooltip: Summons asteroids from the sky
	}

	LeadCore: {
		DisplayName: Lead Core
		Tooltip: Grants immunity to the irradiated debuff
	}

	SurgicalGlove: {
		DisplayName: Surgical Glove
		Tooltip:
			'''
			Melee attacks and projectiles inflict the Plague
			12% increased melee speed, damage, and 3% increased melee critical strike chance
			8% increased true melee damage
			Grants immunity to Plague
			'''
	}

	SulfuricScale: {
		DisplayName: Sulfuric Scale
		Tooltip:
			'''
			While under the effects of a damaging debuff, you gain 10% increased damage and 5% crit
			For every 25% of lost life, you gain 6% increased damage and 3% crit
			This will max out at 18% increased damage and 9% crit when under 25% life
			Provides immunity to poisoned, venom, and sulphuric poisoning
			'''
	}

	FlaskOfPlague: {
		DisplayName: Flask of Plague
		Tooltip: Melee, Whip, and Rogue attacks inflict Plague
	}

	PlagueBalloon: {
		DisplayName: Plague Balloon
		Tooltip: "'Full of Vitamin A'"
	}

	Microxodonta: {
		DisplayName: Microxodonta
		Tooltip:
			'''
			92% increased movement speed
			Flying leaves behind batches of damaging microbial clusters
			'''
	}

	SeaShell: {
		DisplayName: Sea Shell
		Tooltip:
			'''
			Increased defense and damage reduction when submerged in liquid
			Increased movement speed when submerged in liquid
			'''
	}

	MirageJellyItem: {
		DisplayName: Mirage Jelly
		Tooltip: Lowers the cost of stealth strikes by 5%
	}

	InvertedGar: {
		DisplayName: Inverted Gar
		Tooltip:
			'''
			Taking damage will temporarily prevent mana from being consumed.
			Thanks for nothing
			'''
	}

	GlacialCrusher: {
		DisplayName: Glacial Crusher
		Tooltip:
			'''
			Fires slow frost projectiles that freeze enemies
			True melee strikes cause tremendous damage to frozen enemies
			'''
	}

	TrashofMagnus: {
		DisplayName: Trash of Magnus
		Tooltip:
			'''
			An attempt of Magnus' to expand into biological terrorism
			Despite his efforts, it was deemed a failure and discarded
			Fires plague bolts that inflict Plague
			This weapon scales with all your damage stats at once
			'''
	}

	BlowPipe: {
		DisplayName: Blow Pipe
		Tooltip:
			'''
			70% chance to not consume darts
			Right click to a stingy stinger
			'''
	}

	TheNeedler: {
		DisplayName: The Needler
		Tooltip: ""
	}

	Disease: {
		DisplayName: Disease
		Tooltip:
			'''
			Enemies release plague seekers on death
			Shortflurry attacks summon plague seekers on each hit
			'''
	}

	Reemergence: {
		DisplayName: Reemergence
		Tooltip: Converts wooden arrows into plague arrows that explode into bees on death
	}

	ToxicWisdom: {
		DisplayName: Toxic Wisdom
		Tooltip: "'What? I do not remember this being made. I do not know if it ever even had an effect, but I guess it was sprited. Do what you wish. -Draedon'"
	}

	Decomposition: {
		DisplayName: Decomposition
		Tooltip: Summons a diseased hive to protect you
	}

	MetalBall: {
		DisplayName: Metal Ball
		Tooltip: Throws out a ball of plague nanometal that is affected by gravity which moves based on your movements
	}

	SewerBrewer: {
		DisplayName: Sewer Brewer
		Tooltip:
			'''
			Hold the attack button to charge the drill, release to fire a drill bit that increases in size and damage the more it is charged
			Fully charged drill bits home in towards enemies
			Drill bits slow down while hitting enemies
			Enemies hit by the drill bit are infected with the Plague
			'''
	}

	Terracotta: {
		DisplayName: Terra-cotta
		Tooltip:
			'''
			Causes enemies to erupt into healing projectiles on death
			Enemies explode on hit
			'''
	}

	BloodClotStaff: {
		DisplayName: Blood Clot Staff
		Tooltip: Summons a blood clot to fight for you
	}

	PsychoticAmulet: {
		DisplayName: Psychotic Amulet
		Tooltip:
			'''
			Boosts Spy and ranged damage and critical strike chance by 5%
			Grants a massive boost to these stats if you aren't moving
			'''
	}

	ManaJelly: {
		DisplayName: Mana Jelly
		Tooltip:
			'''
			+20 max mana
			Standing still boosts mana regen
			'''
	}

	FungalCarapace: {
		DisplayName: Fungal Carapace
		Tooltip: You emit a mushroom spore explosion when you are hit
	}

	AmidiasSpark: {
		DisplayName: Amidias' Spark
		Tooltip: Taking damage releases a blast of sparks
	}

	EnergyStaff: {
		DisplayName: Energy Staff
		Tooltip: Summons a profaned energy turret to fight for you
	}

	Starfall: {
		DisplayName: Starfall
		Tooltip: Casts a spread of astral blight stars at the mouse cursor
	}

	StormDragoon: {
		DisplayName: Storm Dragoon
		Tooltip:
			'''
			Fires a spray of bullets
			90% chance to not consume ammo
			'''
	}

	SoulEdge: {
		DisplayName: Soul Edge
