		DisplayName: Wisdom of Survival
		Tooltip: Casts a slow orb of water that splits into seeking droplets
	}

	TerreyeStaff: {
		DisplayName: Terreye Staff
		Tooltip:
			'''
			Takes up 4 minion slots to summon a trio of floating biomasses to shoot at and ram at enemies
			Hold right click on an enemy to channel a sigil on them
			Once the sigil reaches full size, the trio rapidly converge on it, dealing massive damage and spawning healing life hearts
			Only one set of eyes can exist
			'''
	}

	TheDreamingGhost: {
		DisplayName: The Dreaming Ghost
		Tooltip:
			'''
			Beneath the tree's roots lies the pain of a thousand souls
			Summons a pair of crystalline butterflies to fight for you
			Each pair takes up 4 minion slots
			Each active purple butterfly increases your damage by 10%
			Each active pink butterfly increases your life regeneration by 2
			'''
	}
	QuantumFlahiumShockDevice: {
		DisplayName: Quantum Flahium Shock Device
		Tooltip:
			'''
			40% increased melee damage and speed
			35% increased true melee damage
			True melee strikes will emit flah in various directions
			15% increased melee critical strike chance
			+10 armor penetration
			Increases melee damage, true melee damage and melee speed the closer you are to enemies
			'''
	}

	QuantumFlahiumEjectionDevice: {
		DisplayName: Quantum Flahium Ejection Device
		Tooltip:
			'''
			Spy projectiles create flahblades as they travel
			Stealth strikes summon flahbeams and sparks on enemy hits
			Stealth strikes have +50 armor penetration, and deal 10% more damage
			50% increased Spy damage and 25% increased Spy velocity
			15% increased Spy crit chance
			Stealth strikes have a 100% critical hit chance
			Stealth generates 15% faster
			Stealth strikes only expend 50% of your max stealth
			+50 maximum stealth
			Spy projectiles explode into homing souls on death
			'''
	}

	ZenithArcanum: {
		DisplayName: Zenith Arcanum
		Tooltip:
			'''
			Top of the food chain
			Summons various spirits of the world to protect you
			20% increase to summon damage and defense
			+4 life regeneration, 15% increased pick speed, and +8 max minions
			Increased minion knockback
			Minions inflict a variety of debuffs and spawn skeletal limbs on enemy hits
			'''
	}
	Klepticoin: {
		DisplayName: Klepticoin
		Tooltip:
			'''
			Worth 100 Cosmilite Coins
			Can be fired by the Coin Gun
			'''
	}

	ExoAvalon: {
		DisplayName: Exo Avalon
		Tooltip:
			'''
			Crazy? I was crazy once. They locked me in a room. A rubber room! A rubber room with rats, and rats make me crazy!!
			Crazy? I was crazy once...
			'''
	}

	Dialup: {
		DisplayName: Dialup
		Tooltip: The dialup is a hammer i think
	}
	CentStriker: {
		DisplayName: Cent Striker
		Tooltip: The weakest coin shooter
	}

	HolyPurge: {
		DisplayName: Holy Purge
		Tooltip:
			'''
			Incinerates your foes with the holy fire.
			90% chance to not consume gel.
			'''
	}

	HolidayHalberd: {
		DisplayName: Holiday Halberd
		Tooltip:
			'''
			idk I'm miserable with names
			- The General
			Fires red and green bouncing gift bags that emit clouds as they travel
			'''
	}

	TheLastLightice: {
		DisplayName: The Last Lightice
		Tooltip:
			'''
			It is said that in the past, Daedalus ascended from the void to grant man ice.
			If that were true, then it is surely the angels of heaven that would have fallen from above to do the same.
			Rapidly throws out a stream of magic ice that places upon tile or enemy hits
			Stealth Strikes shoot out a burst of ice
			'''
	}

	DeathNeedleStinger: {
		DisplayName: Death-Needle Stinger
		Tooltip:
			'''
			Throws a chained needle to gouge your enemies
			Up to 3 can be out at a time
			Right click to throw out a stinger to inflict a horrible doom
			Stealth strike throws out all 3 needles at once and grapple struck enemy to you
			'''
	}

	LeavesofCrabulon: {
		DisplayName: Leaves of Crabulon
		Tooltip: Gives decent buffs to ALL offensive and defensive stats
	}

	CosmicStone: {
		DisplayName: Cosmic Stone
		Tooltip: Summons a cosmic elemental to fight for you
	}

	OilBottle: {
		DisplayName: Oil Bottle
		Tooltip:
			'''
			One of the ancient relics
			Summons a solver elemental to fight for you
			'''
	}

	ProfanedWhiplash: {
		DisplayName: Profaned Whiplash
		Tooltip:
			'''
			Powered by the profaned flame.
			Generates Holy Flame explosions on enemy hits, struck enemies spawn a few homing crystal shards on death.
			12 summon tag damage
			'''
	}

	Cirrhotipede: {
		DisplayName: Cirrhotipede
		Tooltip:
			'''
			30 summon tag damage
			Leaves behind plague nanites
			Your summons will focus struck enemies
			[c/7cad1f:'Apparently, the thong of the whip itself is ripped from the spine of the plagued goliath itself, and then its end had a failing liver attached, carved to look like a scythe. Yuck.']
			'''
	}

	PlagueCallerMKIII: {
		DisplayName: Plague Caller MK III
		Tooltip:
			'''
			Consumes all remaining minion slots to summon the Plague Emperor
			The emperor will swarm enemies with hordes of plague weaponry and bees
			Yharim shivers in fear at the thought of such a monstrosity...
			'''
	}

	BadApple: {
		DisplayName: Bad Apple
		Tooltip:
			'''
			Summons Utsuho Reiuji to fight for you using nuclear power
			Utsuho requires 5 minion slots to summon, and can only be summoned once
			You might cause another incident
			'''
	}
	KosFragment: {
		DisplayName: Kos Fragment
		Tooltip:
			'''
			A relic of the Bones
			Contains a bit of the power some guys kind of want
			When used in certain areas of the world, it will call them
			Not consumable
			'''
	}

	Everflute: {
		DisplayName: Everflute
		Tooltip: Summons a powerful bird type monster
	}

	CrystallisedStiriaticChunk: {
		DisplayName: Crystallised Stiriatic Chunk
		Tooltip: Summons a stiriatic walkie to follow you around
	}

	DeviousAestheticus: {
		DisplayName: Devious Aestheticus
		Tooltip:
			'''
			Shot spread scales with up to 8 empty minion slots
			'If you're seeing this, You've been in a coma for 20 years, I don't know where this message will be, but please wake up'
			'''
	}

	Wakasagihime: {
		DisplayName: Wakasagihime
		Tooltip: ᗜˬᗜ
	}
	MiracleCoin: {
