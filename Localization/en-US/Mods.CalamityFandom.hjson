}

Configs: {
	FandomConfig: {
		DisplayName: Calamity Fandom
		Headers.Debug: Debug

		Accuracy: {
			Label: Fandom accuracy
			Tooltip:
				'''
				Full Fandom: only what the Fandom wiki says. Calamity content added after the wiki was abandoned (2.0.1.005) is hidden, and 2022 values are applied as the wiki shows them.
				Calamity++: current Calamity, plus everything the Fandom wiki adds or changes, with balancing so that everything is playable.
				'''
		}

		WarnOnWorldModeMismatch: {
			Label: Warn on world mode mismatch
			Tooltip: Warn when entering a world created in Full Fandom with Calamity++, or the other way around.
		}

		DisableBalanceLayer: {
			Label: Disable Calamity++ balancing
			Tooltip: Debug only. Calamity++ without its balance layer, to compare the raw Fandom changes with the balanced ones.
		}
	}

	PlayerAccuracy: {
