	}

	FrostflowEdge: {
		DisplayName: Frostflow Edge
		Tooltip:
			'''
			Drains a percentage of enemy health on hit
			Right click to drain all current mana and a percentage of your own health to empower the sword
			Cannot inflict critical hits
			Player starts taking severe damage when fully submerged in water with less than 40 defense
			'''
	}

	OmegaRay: {
		DisplayName: Omega Ray
		Tooltip:
			'''
			Disintegrates everything with a penta-beam of energy and lasers
			Right click to fire an ogscule-shaped beam of destructive energy that split into randomly spinning lasers
			'''
	}

