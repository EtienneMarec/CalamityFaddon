	{
		MarkedforDeath:
		{
			DisplayName: Marked
		}
		Nightwither:
		{
			DisplayName: Moon Burnt
		}
		WeaponImbueBrimstone:
		{
			Description: Melee, Whip, and Spy attacks ignite enemies with brimstone flames
		}
		WeaponImbueCrumbling:
		{
			Description: Melee, Whip, and Spy attacks reduce enemy damage reduction
		}
		WeaponImbueHolyFlames:
		{
			Description: Melee, Whip, and Spy attacks dissolve enemies with holy flames
		}
	}
	Common:
	{
		CanMineUelibloom: Can mine Tarragon Ore
		DodgeInformation:
			'''
			[i/Terraria:BlackBelt] Attacks that deal less than 5% of your max life in damage will not be dodged
			[i/Terraria:BlackBelt] This dodge has a maximum cooldown of 90 seconds, shortened depending on the dodged attack's damage
			[i/Terraria:BlackBelt] Equipping multiple coverings that give this ability to dodge will reduce the cooldown by 15% each
			'''
		RogueCrit: "{0}% increased spy critical strike chance"
		RogueDamage: "{0}% increased spy damage"
		RogueDamageCrit: "{0}% increased spy damage and critical strike chance"
		RogueVelocity: "{0}% increased spy velocity"
	}
	Condition:
	{
		Drops:
		{
			DownedAD: After defeating Astral Deus
			DownedRav: After defeating the Meatmetal Sans
		}
		HasRogueArmor: While wearing spy armor
		InCrag: In the Brimstone Crag
	}
	Configs:
	{
		CalamityClientConfig:
		{
			StealthInvisibility:
			{
				Tooltip:
					'''
					Enables players gradually turning invisible as their Spy Stealth increases.
					This effect is visually similar to Shroomite armor's stealth.
					'''
			}
			StealthMeter:
			{
				Tooltip:
					'''
					Enables the Stealth Meter UI, which shows the player's current stealth level.
					The Stealth Meter is always hidden if not wearing Spy armor.
					'''
			}
		}
		CalamityServerConfig:
		{
			FasterTilePlacement:
			{
				Tooltip:
					'''
					Substantially increases how rapidly the player can place tiles and walls.
					This config stacks with the Brick Layer, Portable Cement Mixer and other coverings.
					'''
			}
			RemoveReforgeRNG:
			{
				Tooltip:
					'''
					Removes randomness from the Goblin Tinkerer's reforges for both weapons and coverings.
					Disable this if using mods that change reforging on their own to prevent conflicts.
					'''
			}
		}
	}
	DamageClasses:
	{
		RogueDamageClass:
		{
			DisplayName: spy damage
		}
	}
	GameTips:
	{
		StealthTip: Wearing any spy class armor lets you build stealth!
	}
	Items:
	{
		Accessories:
		{
			Abaddon:
			{
				Unequipped: Equip this covering to view your current [cbuff:CalamityMod/Bane] damage
			}
			Apollyon:
			{
				Unequipped: Equip this covering to view your current [cbuff:CalamityMod/Bane] damage
			}
			BlunderBooster:
			{
				Tooltip:
					'''
					12% increased spy damage and 15% increased spy projectile velocity
					Stealth generates 10% faster
					Summons a red lightning aura around the player that electrifies nearby enemies with [cbuff:CalamityMod/VermillionFlux]
					The aura has reduced opacity if visibility is disabled
					Press [KEY] to consume 25% of your maximum stealth to perform a swift upwards diagonal dash
					This dash leaves a trail of red lightning bolts
					This effect has a 1 second cooldown before it can be used again
					'''
			}
			ChaliceOfTheBloodGod:
			{
				Tooltip:
					'''
					Increases max HP by 25%
					+2 HP/s life regen and reduces the cooldown of healing potions by 25%
					Taking more than 5 damage converts the hit into a damage over time bleed effect
					This bleeding does not interfere with life regeneration
					Drinking a healing potion removes some of the remaining bleed, up to 50% of its heal value
					Unequipping this covering while bleeding inflicts the remaining damage instantly
					Grants immunity to [cbuffplr:Bleeding], [cbuffplr:CalamityMod/BurningBlood], [cbuffplr:CalamityMod/HeavyBleeding], and [cbuffplr:CalamityMod/Laceration]
					'All that for a drop of blood...'
					'''
			}
			CoinofDeceit:
			{
				Tooltip:
					'''
					Stealth strikes only expend 90% of your max stealth
					6% increased spy crit chance
					'''
			}
			DarkMatterSheath:
			{
				Tooltip:
					'''
					+10 maximum stealth
					Stealth generation is boosted while moving if not attacking
					Stealth strikes only expend 50% of your max stealth
					6% increased spy damage and spy crit chance
					'''
			}
			DragonScales:
			{
				Tooltip:
					'''
					Spy projectiles spawn slow fireballs as they travel
					Stealth strikes create infernados where they hit
					+10% max run speed and acceleration
					Grants immunity to [cbuffplr:CalamityMod/Dragonfire]
					'Only a living dragon holds true treasure'
					'''
			}
			EclipseMirror:
			{
				Tooltip:
					'''
					+10 maximum stealth
					6% increased spy damage and spy crit chance
					Enemies are less likely to target you, even in the abyss
					Stealth generates 25% faster when standing still and is boosted while moving if not attacking
					Stealth strikes only expend 50% of your max stealth
					{$Common.DodgeProvided}
					Dodging an attack restores stealth and releases a burst of highly damaging darksun light
					'''
			}
			EtherealExtorter:
			{
				Tooltip:
					'''
					Spy projectiles explode into homing souls on hit
					8% increased spy damage and +5 maximum stealth
					'''
			}
			FragmentsOfAnotherWorld:
			{
				Tooltip:
					'''
					Grants immunity to [cbuffplr:CalamityMod/WhisperingDeath]
					{0}% increased melee speed
					{1}x specialist ranged damage
					{2}% reduced mana usage
					+{3} maximum sentries
					{4}% increased spy attack speed
					[c/ff0000:'Don't speak of your desires to the shadows, they listen.']
					'''
			}
			FrozenCube:
			{
				Unequipped: Equip this covering to view its statistics
			}
			GloveOfPrecision:
			{
				Tooltip:
					'''
					Decreases spy attack speed by 15%
					Increases spy damage and critical strike chance by 10%, and velocity by 15%
					'''
			}
			GloveOfRecklessness:
			{
				Tooltip:
					'''
					Increases spy attack speed by 15%, but decreases damage by 10% and crit by 5%
					15% increased stealth regeneration
					Makes spy weapons slightly inaccurate
					'''
			}
			HowlsHeart:
			{
				Tooltip:
					'''
					Summons Howl to fight for you, Calcifer to light your way, and Turnip-Head to follow you around
					Placing this covering in vanity slots will summon the trio without the combat or exploration utilities
					'''
			}
			Nanotech:
			{
				Tooltip:
					'''
					Spy projectiles create nanoblades as they travel
					Stealth strikes summon nanobeams and sparks on enemy hits
					Stealth strikes have lifesteal, +15 armor penetration, deal 5% more damage
					15% increased spy damage and 15% increased spy velocity
					Stealth strikes grant lifesteal and 10% critical strike chance to non-stealth strikes for 10 seconds
					'''
			}
			PlaguedFuelPack:
			{
				Tooltip:
					'''
					8% increased spy damage and 15% increased spy projectile velocity
					Stealth generates 10% faster
					Press [KEY] to consume 25% of your maximum stealth to perform a swift upwards diagonal dash
					The dash leaves a lingering trail of [cbuff:CalamityMod/Plague] clouds
					This effect has a 1 second cooldown before it can be used again
					'''
			}
			ProfanedSoulCrystal:
			{
				FullTooltip:
					'''
					Provides passive buffs depending on the time of day
					Greatly boosts the power of the Guardian's relics
					Grants additional effects if you have {0} unused minion slots
					Summons your own personal Guardians to fight alongside you
					All non-summon attacks are transformed, and are empowered if no minions are active
					[c/ffa680:Melee] [c/ffd2bf:attacks become a barrage of spears]
					[c/99ffa7:Ranged] [c/bfffc8:attacks become a flurry of fireballs and meteors]
					[c/8cbeff:Magic] [c/bfdbff:attacks become a giant splitting fireball, costing {1} mana]
					[c/d791f2:Whips] [c/e1b6f2:become overtaken by profaned crystal]
					[c/f285a2:Spy] [c/f2b6c6:attacks become a deadly crystalline spiral]
					Thinking back, it was a boring life
					[c/FFBF49:And so we burn it all in the name of purity]
					'''
			}
			RogueEmblem:
			{
				DisplayName: Spy Emblem
				Tooltip: 15% increased spy damage
			}
			RuinMedallion:
			{
				Tooltip:
					'''
					Stealth strikes only expend 75% of your max stealth
					6% increased spy damage and spy crit chance
					'''
			}
			StatMeter:
			{
				RogueStats:
					'''
					Max Stealth: {0} | Standing Regen: {1} / sec | Moving Regen: {2} / sec
					Spy Velocity Boost: {3}%
					'''
			}
			VampiricTalisman:
			{
				Tooltip:
					'''
					Spy critical strikes steal enemy life
					Stealth strikes grant 15% critical strike chance and increased lifesteal to non-stealth strikes for 10 seconds
					Stealth strikes inflict [cbuff:CalamityMod/HeavyBleeding] and [cbuff:CalamityMod/ArmorCrunch], and deal 8% more damage
					'Possessing the talisman makes you yearn for blood'
					'''
			}
			VeneratedLocket:
			{
				Tooltip:
					'''
					10% increased spy damage
					Spy projectiles summon a clone from above the cursor
					Stealth strikes unleash a ring of seeking cosmilite knives
					'You'll never be alone, no matter where you go'
					'''
			}
		}
