{
	Bestiary:
	{
		AstrumDeus: When a star begins to die, under normal circumstances, its power simply fades as it falls to the nearest celestial body. However, some dying stars bloat and fester before falling. Astral Deus exists to consume these stars before the Astral Infection manifests in them, and it has been revered for its sacred duty since time immemorial.
	}
	Biomes:
	{
		BrimstoneCrags: Brimstone Crag
		BrimstoneCragsBiome:
		{
			DisplayName: Brimstone Crag
			TownNPCDialogueName: Brimstone Crag
		}
	}
	BossChecklistIntegration:
	{
		AstrumDeus:
		{
			EntryName: Astral Deus
		}
		BrimstoneElemental:
		{
			SpawnInfo: Use a [i:CalamityMod/CharredIdol] in the Brimstone Crag or Azafure.
		}
		Ravager:
		{
			DespawnMessage: "[c/B22222:The Meatmetal Sans resumes its aimless, horrific rampage.]"
			EntryName: Meatmetal Sans
		}
	}
